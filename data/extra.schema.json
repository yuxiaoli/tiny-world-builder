{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyworld.local/extra.schema.json",
  "title": "Extra",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["fence", "tuft"]
    },
    "k": {
      "type": "string",
      "enum": ["fence", "tuft"]
    },
    "fenceSide": {
      "$ref": "world.schema.json#/$defs/fenceSide"
    },
    "s": {
      "$ref": "world.schema.json#/$defs/fenceSide"
    },
    "floors": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "f": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    }
  },
  "anyOf": [
    { "required": ["kind"] },
    { "required": ["k"] }
  ]
}
