{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyworld.local/appearance.schema.json",
  "title": "Appearance",
  "type": ["object", "null"],
  "additionalProperties": false,
  "properties": {
    "bodyColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "topColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "voxelBuildId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "objectScale": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 4
    },
    "scaleX": {
      "type": "number",
      "minimum": 0.15,
      "maximum": 5
    },
    "scaleY": {
      "type": "number",
      "minimum": 0.15,
      "maximum": 5
    },
    "scaleZ": {
      "type": "number",
      "minimum": 0.15,
      "maximum": 5
    },
    "materialTexture": {
      "type": "string"
    },
    "materialTextureScale": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 4
    },
    "bodyTexture": {
      "type": "string"
    },
    "bodyTextureScale": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 4
    },
    "topTexture": {
      "type": "string"
    },
    "topTextureScale": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 4
    },
    "objectStyle": {
      "type": "string",
      "enum": ["normal", "voxel"]
    }
  }
}
